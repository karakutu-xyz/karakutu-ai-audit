    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "parse5": "7.1.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
