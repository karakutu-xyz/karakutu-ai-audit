{
  "name": "karakutu-ai-audit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 2201 --strictPort",
    "build": "tsc -b && vite build",
