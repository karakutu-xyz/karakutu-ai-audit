# Explained configuration source. Copy with make env; never commit credentials.
# Plain KEY=value assignments; full-line comments only. Empty secrets are intentional.
# Quote values containing spaces or shell punctuation with single or double quotes.
# Never use $ or a backslash in a value: other loaders would expand or unescape it,
# so make dev refuses it. Names must be the documented upper-case keys below.
# Runtime defaults below mean unset, which can differ from this local example.
# make test/live select mode; RUN_MODE=test make dev selects local offline demo.

# --- Core / run mode ---

# Select offline demo (test) or real integrations (live).
# Default when unset: API/example: live; run-local: test; Compose selects mode.
# Required: test/live/production: select mode.
RUN_MODE=live

# Local private storage directory; Compose overrides to /data.
# Default when unset: data.
# Required: test/live/production: default sufficient.
DATA_DIR=./data

# Live SQLite URL; test ignores it and uses DATA_DIR/demo/audit-test.sqlite3.
# Default when unset: live: DATA_DIR/audit.sqlite3.
# Required: test: ignored; live/production: optional override.
DATABASE_URL=

# Concurrent audits inside the single API process (1 to 8).
# Default when unset: 1.
# Required: test/live/production: default sufficient.
MAX_CONCURRENT_RUNS=1

# --- Model ---

# Enable model calls; test mode always ignores integrations.
# Default when unset: false (example enables it).
# Required: test: ignored; live/production: true for useful audits.
MODEL_ENABLED=true

# Local/Tilt OpenAI-compatible inference endpoint.
# Default when unset: http://127.0.0.1:1234/v1.
# Required: test: ignored; live/production: reachable endpoint.
MODEL_BASE_URL=http://127.0.0.1:1234/v1

# Provider profile: lmstudio or openai_compatible.
# Default when unset: lmstudio.
# Required: test: ignored; live/production: choose provider.
MODEL_PROVIDER=lmstudio

# Chat model identifier; auto discovers the first chat model.
# Default when unset: auto.
# Required: test: ignored; live/production: loaded model or auto.
MODEL_NAME=auto

# Provider credential; unauthenticated local servers accept empty with either profile.
# Default when unset: lm-studio (example leaves empty).
# Required: test: ignored; live/production: only if provider needs auth (hosted does).
# SECRET
MODEL_API_KEY=

# Model request timeout in seconds (1 to 600).
# Default when unset: 90.
# Required: test: ignored; live/production: optional.
MODEL_TIMEOUT=90

# Maximum model output tokens (128 to 16384); a limit, not a credential.
# Default when unset: 2048.
# Required: test: ignored; live/production: optional.
MODEL_MAX_TOKENS=2048

# Model sampling temperature.
# Default when unset: 1.0.
# Required: test: ignored; live/production: optional.
MODEL_TEMPERATURE=1.0

# Thinking extension: lmstudio, reasoning_effort or none; set none for hosted.
# Default when unset: lmstudio profile: lmstudio; openai_compatible: none.
# Required: test: ignored; live/production: optional; omit rather than set empty.
MODEL_THINKING_CONTROL=lmstudio

# JSON mode: json_schema, json_object or auto; hosted usually auto.
# Default when unset: lmstudio: json_schema; openai_compatible: auto.
# Required: test: ignored; live/production: optional; omit rather than set empty.
MODEL_RESPONSE_FORMAT=json_schema

# --- Step models ---

# Optional classification model; latest API assignment wins.
# Default when unset: inherit MODEL_NAME.
# Required: test: ignored; live/production: optional.
MODEL_NAME_CLASSIFICATION=

# Optional relevance model; latest API assignment wins.
# Default when unset: inherit MODEL_NAME.
# Required: test: ignored; live/production: optional.
MODEL_NAME_RELEVANCE=

# Optional related removals model; latest API assignment wins.
# Default when unset: inherit MODEL_NAME.
# Required: test: ignored; live/production: optional.
MODEL_NAME_RELATED_REMOVALS=

# Optional source model; latest API assignment wins.
# Default when unset: inherit MODEL_NAME.
# Required: test: ignored; live/production: optional.
MODEL_NAME_SOURCE=

# Optional web search model; latest API assignment wins.
# Default when unset: inherit MODEL_NAME.
# Required: test: ignored; live/production: optional.
MODEL_NAME_WEB_SEARCH=

# --- Search (SearXNG) ---

# Search backend: searxng or disabled.
# Default when unset: disabled (example uses searxng).
# Required: test: ignored; live/production: optional search.
SEARCH_PROVIDER=searxng

# Local/Tilt search endpoint; Compose overrides to internal service.
# Default when unset: http://127.0.0.1:2202.
# Required: test: ignored; live/production: required when searxng.
SEARXNG_URL=http://127.0.0.1:2202

# SearXNG signing secret. Tooling only, not read by the API.
# Default when unset: empty.
# Required: test: unused; live/production: required for bundled search.
# SECRET
SEARXNG_SECRET=

# --- Archive (karakutu) ---

# Trusted read-only archive API; empty disables archive reads.
# Default when unset: empty (disabled).
# Required: test: ignored; live/production: optional.
ARCHIVE_BASE_URL=

# Path to your own read-auth keyfile outside the repo.
# Default when unset: empty.
# Required: test: ignored; live/production: only when archive requires auth.
# SECRET
ARCHIVE_WALLET_PATH=

# Inline read-auth wallet JSON; prefer a keyfile path; quote JSON in shell.
# Default when unset: empty.
# Required: test: ignored; live/production: alternative to wallet path.
# SECRET
ARCHIVE_WALLET_JSON=

# --- Access and security ---

# Bearer token (at least 32 characters); protects all /api data when set.
# Default when unset: empty.
# Required: test/live: remote access or editing; live: ingestion; production: required.
# SECRET
API_AUTH_TOKEN=

# Extra comma-separated hosts without schemes/ports; remote hosts need token.
# Default when unset: localhost,127.0.0.1,testserver.
# Required: test/live: remote access; production: public proxy hostname.
ALLOWED_HOSTS=

# Extra comma-separated browser origins, no trailing slash.
# Default when unset: http://localhost and http://127.0.0.1 on 2200/2201.
# Required: test/live: non-default origins; production: public TLS origin.
ALLOWED_ORIGINS=

# --- Live ingestion ---

# Enable authenticated live submissions; benchmarks remain separate.
# Default when unset: false.
# Required: test: ignored; live/production: only for live intake; token required.
LIVE_INGESTION_ENABLED=false

# --- Docker / Compose ---

# Container-visible model URL; overrides MODEL_BASE_URL. Tooling only.
# Default when unset: http://host.docker.internal:1234/v1.
# Required: test: ignored; live/production: reachable model endpoint.
CONTAINER_MODEL_BASE_URL=

# Compose API/UI publish address; API validates it; local runner stays loopback.
# Default when unset: Compose: 127.0.0.1; API: empty.
# Required: test/live/production: loopback recommended; remote requires token.
KARAKUTU_BIND_ADDRESS=127.0.0.1

# Published API/local runner port. Tooling only, not read by API.
# Default when unset: 2200.
# Required: test/live/production: optional.
KARAKUTU_API_PORT=2200

# Published UI/local runner port; API adds matching loopback origins.
# Default when unset: Compose/runner: 2201; API: unset.
# Required: test/live/production: optional.
KARAKUTU_WEB_PORT=2201

# Published loopback search port. Tooling only, not read by API.
# Default when unset: 2202.
# Required: test: unused; live/production: optional.
KARAKUTU_SEARCH_PORT=2202

# --- Dev tooling ---

# Vite API proxy target. Tooling only, not read by API.
# Default when unset: Vite: http://127.0.0.1:2200; runner derives API port.
# Required: test/live: optional local proxy; production: unused by built UI.
KARAKUTU_API_PROXY=

# Make env token-generation flag (1 enables). Tooling only.
# Default when unset: 0.
# Required: test/live/production: optional setup flag.
API_TOKEN=0

# Make live Compose project name. Tooling only.
# Default when unset: karakutu-ai-audit.
# Required: test/live/production: optional Make override.
PROJECT=karakutu-ai-audit

# Make test Compose project name. Tooling only.
# Default when unset: PROJECT plus -test.
# Required: test: optional Make override; live/production: unused.
TEST_PROJECT=karakutu-ai-audit-test

# Make live Compose file arguments. Tooling only.
# Default when unset: -f compose.yaml.
# Required: test/live/production: optional Make override.
LIVE_FILES='-f compose.yaml'

# Make backup/restore data volume. Tooling only.
# Default when unset: PROJECT plus _karakutu-audit-data.
# Required: production: match stack when backing up; otherwise optional.
VOLUME=karakutu-ai-audit_karakutu-audit-data

# Make backup/restore helper image. Tooling only.
# Default when unset: PROJECT plus -karakutu-audit-api.
# Required: production: match built image for backup; otherwise optional.
API_IMAGE=karakutu-ai-audit-karakutu-audit-api

# Make backup destination; must exist outside checkout. Tooling only.
# Default when unset: unset.
# Required: production: required for backup; otherwise unused.
BACKUP_DIR=

# Make restore archive path. Tooling only.
# Default when unset: unset.
# Required: production: required for restore; otherwise unused.
BACKUP_FILE=

# Make restore restarts API when 1; 0 leaves it stopped. Tooling only.
# Default when unset: 1.
# Required: test/live/production: optional restore flag.
START=1

# Smoke run name prefix; random suffix always appended. Tooling only.
# Default when unset: karakutu-smoke.
# Required: test/live/production: unused; smoke: optional.
SMOKE_PROJECT=karakutu-smoke

# Commit exercised by Docker smoke suite. Tooling only.
# Default when unset: HEAD.
# Required: test/live/production: unused; smoke: optional.
SMOKE_REF=HEAD

# Smoke API loopback port. Tooling only.
# Default when unset: 23100.
# Required: test/live/production: unused; smoke: optional.
SMOKE_API_PORT=23100

# Smoke UI loopback port. Tooling only.
# Default when unset: 23101.
# Required: test/live/production: unused; smoke: optional.
SMOKE_WEB_PORT=23101

# Smoke search loopback port. Tooling only.
# Default when unset: 23102.
# Required: test/live/production: unused; smoke: optional.
SMOKE_SEARCH_PORT=23102

# Keep smoke-built images when 1. Tooling only.
# Default when unset: 0.
# Required: test/live/production: unused; smoke: optional.
SMOKE_KEEP_IMAGES=0

# Optional old commit for smoke upgrade test. Tooling only.
# Default when unset: empty (skip upgrade).
# Required: test/live/production: unused; smoke: optional.
SMOKE_UPGRADE_FROM=

# Generated smoke API image name; do not set manually. Tooling only.
# Default when unset: generated by docker_smoke.sh.
# Required: test/live/production: unused; smoke override: generated.
SMOKE_API_IMAGE=

# Generated smoke UI image name; do not set manually. Tooling only.
# Default when unset: generated by docker_smoke.sh.
# Required: test/live/production: unused; smoke override: generated.
SMOKE_WEB_IMAGE=

# Generated smoke fixture directory; do not set manually. Tooling only.
# Default when unset: generated by docker_smoke.sh.
# Required: test/live/production: unused; smoke override: generated.
SMOKE_DIR=

# Generated smoke bearer token; do not set manually. Tooling only.
# Default when unset: generated by docker_smoke.sh.
# Required: test/live/production: unused; smoke override: generated.
# SECRET
SMOKE_API_TOKEN=

# Offline smoke fake-model port. Tooling only.
# Default when unset: 8000.
# Required: test/live/production: unused; smoke: optional.
FAKE_MODEL_PORT=8000

# Offline fake-model delay; smoke Compose sets 90. Tooling only.
# Default when unset: 60.
# Required: test/live/production: unused; smoke: optional.
FAKE_MODEL_SLOW_SECONDS=60
