PROVIDER_TYPE=local
WEB_SEARCH_PROVIDER=stub
PORT=2200
LOG_LEVEL=INFO
# --- model server: any OpenAI-compatible chat-completions endpoint with tool calling -----------
# false = pydantic-ai's TestModel (synthetic answers; the service logs a SYNTHETIC warning).
# The legacy LMSTUDIO_* names (LMSTUDIO_ENABLED, _BASE_URL, _MODEL, _API_KEY, _TIMEOUT,
# _REQUEST_TIMEOUT, _MAX_TOKENS, _THINKING) are still read as aliases; MODEL_* wins.
MODEL_ENABLED=false
MODEL_BASE_URL=http://localhost:1234/v1
MODEL_NAME=
# Sent as the API key on every call and as `Authorization: Bearer` on the /models health check.
MODEL_API_KEY=lm-studio
# Health-check timeout, seconds (/ready and the worker's model-down pause).
MODEL_HEALTH_TIMEOUT=30
# Bounds on every model call (see src/providers/lmstudio.py). Without the cap and the timeout,
# gemma-4-12b looped for 5 x 600s on one article. 180: three retry-ladder rungs at 180s
# (+overhead) fit the 600s per-case budget (JOB_CASE_TIMEOUT_S); at 240 they did not.
MODEL_REQUEST_TIMEOUT=180
MODEL_MAX_TOKENS=4096
# Empty = not sent (the server's default). LM Studio then uses the model preset
# (gemma-4-12b-qat: 1.0); hosted APIs differ (Scaleway: 0.7), so pin it for a hosted model.
MODEL_TEMPERATURE=
# lmstudio = chat_template_kwargs.enable_thinking=false + reasoning_effort="none" (default)
# reasoning_effort = reasoning_effort="none" only (servers that reject chat_template_kwargs)
# none = send neither (thinking left on, if the model has it)
MODEL_THINKING_CONTROL=lmstudio
#
# Example: Scaleway Generative APIs (Paris, serverless, OpenAI-compatible). The key is an IAM
# secret key scoped to Generative APIs. Changing the model changes results: evaluate first.
#   MODEL_ENABLED=true
#   MODEL_BASE_URL=https://api.scaleway.ai/v1
#   MODEL_NAME=gemma-4-26b-a4b-it
#   MODEL_API_KEY=<SCW_SECRET_KEY>
#   MODEL_TEMPERATURE=1.0
#   MODEL_THINKING_CONTROL=reasoning_effort

SEARXNG_URL=http://localhost:8888
SEARXNG_TIMEOUT=15
# The reference profile: every recorded audit run used exactly these three engines.
SEARXNG_ENGINES=google,bing,duckduckgo
SEARXNG_LANGUAGE=tr

# Karakutu Server API (article store + server-side similarity).
# Auth = Arweave wallet challenge -> 15-min JWT, minted automatically from this keyfile.
# No keyfile => client disabled, no calls, similarity stays dormant. Access: reads, plus IPTC
# tag writes and discussion comments when archive writes are enabled (ARCHIVE_WRITES_ENABLED).
KARAKUTU_API_URL=https://k8s.karakutu.xyz
KARAKUTU_WALLET_PATH=arweave-keyfile.json
KARAKUTU_API_TIMEOUT=15
KARAKUTU_CONCEPTS_CACHE=.cache/karakutu-concepts.json
# OR the keyfile CONTENT (a JSON object) from a secret manager, for containers; it wins over
# KARAKUTU_WALLET_PATH when both are set. Private key material: never logged.
KARAKUTU_WALLET_JSON=
# Base of the discussion view_url recorded in the apply ledger.
KARAKUTU_FRONTEND_URL=https://karakutu.xyz

# --- API token + archive writes ----------------------------------------------------------------
# Bearer token (Authorization: Bearer <token>), at least 32 characters (openssl rand -hex 32);
# the service refuses to boot with a shorter one. Set = the /api/v1 article routes and the job
# worker run and require it, /api/audit requires it, /ready serves its detailed view to it.
# Empty = /api/v1 answers 404, no worker, /api/audit open (local development only).
API_AUTH_TOKEN=
# Comma-separated browser origins, applied to every route except /api/v1/* (server-to-server).
# Empty = no CORS at all (default). Use * for local development only.
CORS_ALLOW_ORIGINS=
# Global write switch for article jobs. false = SHADOW MODE: every job is a dry run (nothing is
# PATCHed or POSTed; the rendered comment is stored in the job for review). Even when true, a job
# writes only if the model is real (not TestModel), WEB_SEARCH_PROVIDER is not stub, the IPTC
# catalog is loaded and the wallet is present; otherwise it is forced to a dry run and says why.
# What is written (template C, IPTC tags, one comment) is fixed in code.
ARCHIVE_WRITES_ENABLED=false

# --- jobs: in-process queue + durable store (single replica) ----------------------------------
# Service state directory; must be a persistent volume in a container.
DATA_DIR=data
# sqlite:///<path> (absolute: sqlite:////var/lib/x.sqlite3) or memory:// (tests only).
# Empty = sqlite:///<DATA_DIR>/karakutu-audit.sqlite3
JOB_STORE_URL=
# Jobs run at once. Keep 1: the model server serialises requests; more only risks timeouts.
JOB_CONCURRENCY=1
# Queued jobs before intake answers 429 (with Retry-After).
JOB_QUEUE_MAX=500
# Hard per-case cap for the six-step audit, seconds (fits 3 x MODEL_REQUEST_TIMEOUT).
JOB_CASE_TIMEOUT_S=600
# Failures (unusable audit / archive unreachable / archive degraded) before a job ends failed.
JOB_MAX_ATTEMPTS=3
# Write-phase retries (the stored result is re-used; the model is not re-run).
JOB_APPLY_MAX_ATTEMPTS=3
# Seconds before a failed attempt is retried.
JOB_RETRY_BACKOFF_S=60
# Consecutive unusable results that pause the worker until the model answers its health check
# (the attempt that triggers the pause does not count toward JOB_MAX_ATTEMPTS).
JOB_FAIL_STREAK=3
JOB_HEALTH_POLL_S=60
JOB_HEALTH_WAIT_MAX_S=14400
# >0: a real run within this many seconds of a successful dry run re-uses that stored result
# (the reviewed one) instead of re-running the audit. Only dry runs whose sole write blocker was
# writes_disabled qualify (never a synthetic model or stub search). 0 = always re-run.
JOB_RESULT_REUSE_S=0
# Finished jobs are pruned after this many days (the apply ledger is never pruned).
JOB_RETENTION_DAYS=180
# On shutdown, seconds the current job may take to finish before it is left for requeue. This
# wait starts after uvicorn's UVICORN_GRACEFUL_TIMEOUT; the stop grace must cover both.
JOB_SHUTDOWN_GRACE_S=30
# Seconds between archive writes (as apply_results.py).
ARCHIVE_WRITE_PACING_S=0.5

# --- docker compose only (read by Compose for ${...} interpolation, not by the service) -------
# Host path of the Arweave wallet keyfile. Compose mounts it read-only into the container and
# points KARAKUTU_WALLET_PATH at it. Empty = no wallet (the archive client stays disabled).
KARAKUTU_WALLET_FILE=
# SearXNG's server secret, required by `docker compose --profile searxng up`; SearXNG refuses to
# start without it. Generate one with: openssl rand -hex 32
SEARXNG_SECRET=
