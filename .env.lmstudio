PROVIDER_TYPE=local
WEB_SEARCH_PROVIDER=searxng
PORT=2200
LOG_LEVEL=INFO
# The reference profile: every recorded audit run used this model, these bounds and this search.
MODEL_ENABLED=true
MODEL_BASE_URL=http://localhost:1234/v1
MODEL_NAME=google/gemma-4-12b-qat
MODEL_API_KEY=lm-studio
MODEL_HEALTH_TIMEOUT=120
# 180: three retry-ladder rungs at 180s (+overhead) fit the 600s per-case budget
# (JOB_CASE_TIMEOUT_S); at 240 a case could hit that budget before its last retry finished.
MODEL_REQUEST_TIMEOUT=180
MODEL_MAX_TOKENS=4096
# Temperature unset: LM Studio applies the model preset (1.0, top_p 0.95, top_k 64).
MODEL_THINKING_CONTROL=lmstudio
SEARXNG_URL=http://localhost:8888
SEARXNG_ENGINES=google,bing,duckduckgo
SEARXNG_LANGUAGE=tr
KARAKUTU_API_URL=https://k8s.karakutu.xyz
# The wallet lives OUTSIDE the repository (never in the working tree).
KARAKUTU_WALLET_PATH=${HOME}/.karakutu-audit/arweave-keyfile.json
KARAKUTU_API_TIMEOUT=15
